#!/bin/sh
# Refuses a push carrying any commit with AI attribution in its message, or
# one that adds a machine-specific string (scripts/check_machine_specifics.py:
# home directories, non-example volumes, private-network addresses).
z=0000000000000000000000000000000000000000
bad=0
while read lref lsha rref rsha; do
    [ "$lsha" = "$z" ] && continue
    if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
    hits=$(git log --format='%h %s%n%b' "$range" 2>/dev/null \
        | grep -ciE '^co-authored-by:.*(claude|anthropic)|generated with \[?claude')
    if [ "${hits:-0}" -gt 0 ]; then
        echo "pre-push: $lref has AI attribution in a commit message; not pushing" >&2
        bad=1
    fi
    if ! python3 "$(git rev-parse --show-toplevel)/scripts/check_machine_specifics.py" --range "$range"; then
        echo "pre-push: $lref adds machine-specific strings; not pushing" >&2
        bad=1
    fi
done
exit $bad
