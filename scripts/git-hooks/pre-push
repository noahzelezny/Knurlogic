#!/bin/sh
# Refuses a push carrying any commit that is AI-attributed -- authored or
# committed as an AI agent, or a message with a trailer or naming an AI
# model as its author or reviewer (ai_identity.sh) -- or one that adds a
# machine-specific string (scripts/check_machine_specifics.py: home
# directories, non-example volumes, private-network addresses).
. "$(dirname "$0")/ai_identity.sh"
z=0000000000000000000000000000000000000000
bad=0
while read lref lsha rref rsha; do
    [ "$lsha" = "$z" ] && continue
    if [ "$rsha" = "$z" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
    who=$(git log --format='%h %an <%ae> / %cn <%ce>' "$range" 2>/dev/null \
        | grep -iE "$AI_IDENT")
    if [ -n "$who" ]; then
        echo "pre-push: $lref has commits by an AI identity; not pushing:" >&2
        echo "$who" | head -5 >&2
        bad=1
    fi
    hits=$(git log --format='%h %s%n%b' "$range" 2>/dev/null | grep -ciE "$AI_NAMED")
    if [ "${hits:-0}" -gt 0 ]; then
        echo "pre-push: $lref has AI attribution in a commit message; not pushing" >&2
        bad=1
    fi
    if ! python3 "$(git rev-parse --show-toplevel)/scripts/check_machine_specifics.py" --range "$range"; then
        echo "pre-push: $lref adds machine-specific strings; not pushing" >&2
        bad=1
    fi
done
exit $bad
